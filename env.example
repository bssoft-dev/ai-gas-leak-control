# run-services.sh 동작 모드
# all: 서비스 실행 전에 모듈을 백그라운드로 자동 실행 후 서비스 선택/실행
# services_only: 서비스(파이프라인)만 선택하여 실행 (기본값)
RUN_SERVICES_MODE=services_only

# (선택) 프론트 dev 서버 내부 포트 오버라이드. 기본 5173. 서비스별 모드는 service.yaml의 ui_server.mode (publish | dev)
# FRONTEND_DEV_PORT=5173

# Docker 설정
USE_DOCKER=false
# true: 프로젝트 루트에서 ./run-core.sh 가 docker compose up 실행 (docker-compose.yml)
# false: 직접 Python으로 실행
#
# 컨테이너만 올리기: docker compose -f docker-compose.yml up -d --build
# 이미지 빌드: docker build -t sagohub:latest .

# SagoHub 설정
# EVENT_BUS_URL은 USE_DOCKER 모드에 따라 자동 설정됩니다.
# USE_DOCKER=false: http://localhost:${EVENT_BUS_PORT} (기본 8000)
# USE_DOCKER=true: 코어는 컨테이너 내부 26010 고정. 호스트에서 서비스(run-services) 연결 시:
#   EVENT_BUS_URL=http://127.0.0.1:${EVENT_BUS_HOST_PORT}  (기본 EVENT_BUS_HOST_PORT=8000)
# 다른 컨테이너가 같은 compose 네트워크에 있으면: http://sagohub:26010
EVENT_BUS_HOST=0.0.0.0
EVENT_BUS_PORT=8000
# Docker(docker-compose.yml)만: 호스트에 노출할 포트. 컨테이너 내부는 항상 26010.
# 호스트 26010 등이 이미 쓰이면 예: EVENT_BUS_HOST_PORT=26011
EVENT_BUS_HOST_PORT=8000
# (선택) 같은 이벤트 버스(26010)를 호스트에서 포트 두 개로 열 때 — docker-compose.yml 해당 ports 줄 주석 해제 후 사용
# EVENT_BUS_HOST_PORT_2=26101
# (선택) main_core가 로컬 이벤트 버스 헬스체크할 URL. 미설정 시 http://127.0.0.1:${EVENT_BUS_PORT}
# EVENT_BUS_URL을 원격(sagohub 등)으로 두어도 코어는 기본적으로 로컬 리슨 포트만 검사합니다.
# EVENT_BUS_HEALTH_URL=

NAS_IP=172.30.1.43
REMOTE_PATH=/volume1/homes/bsjang
LOCAL_MOUNT_POINT=./obsidian
OUTBOX_DIR=./obsidian

# Supabase (M_Supabase 모듈: 데이터 저장/조회, 당배 주문 저장)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# 주문 저장 테이블명 (DANGBAE_ORDER_CREATED 시 사용, 기본 orders)
# SUPABASE_ORDERS_TABLE=orders

# 당배 관리자 페이지 로그인 비밀번호 (dangbae_admin 모듈, 기본값 admin123)
# DANGBAE_ADMIN_PASSWORD=your_admin_password

# 카카오 알림 (동의 후 인가코드→토큰 교환, 나에게 보내기)
# KAKAO_REST_API_KEY=  (카카오 디벨로퍼스 REST API 키)
# 당배 지도: service.yaml config kakao_map_appkey(기본값 있음) 또는 프론트만 띄울 때 services/dangbae/frontend/.env → VITE_KAKAO_MAP_APPKEY=(카카오맵 JavaScript 키, REST 키와 다름)
# KAKAO_REDIRECT_URI=https://dangbae.bs-soft.co.kr
# 신규 배송 등록 시 관리자에게도 카카오톡 발송 (선택)
# KAKAO_ADMIN_ACCESS_TOKEN=
# 배송원·관리자 카카오 알림 본문의「배송 확인」웹 링크 (기본 https://dangbae.bs-soft.co.kr)
# DANGBAE_PUBLIC_URL=https://dangbae.bs-soft.co.kr

# LLM API 설정
LLM_API_BASE=https://llm-api.bs-soft.co.kr
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# document-writer(Sa-Yu) Vite: LLM /models 직접 호출 (미설정 시 Vite dev는 /llm-api 프록시)
# VITE_LLM_API_BASE=https://llm-api.bs-soft.co.kr

# 문서 채팅(doc_chat_llm): POST 본문은 기본 { model, messages, stream:false } 만 전송 (API 스펙과 동일)
# temperature/max_tokens/top_p 를 함께 보내려면: LLM_CHAT_SEND_OPTIONAL=1
# LLM_CHAT_PATH=/v1/chat/completions
# LLM_CHAT_URL=https://llm-api.example.com/v1/chat/completions

# PDF 도면 VLM 분류 (modules/traceability_pdf_vision)
# TRACEABILITY_VISION_API_URL 미설정 시 LLM_API_BASE + POST /chat/vlm/nim 사용
# TRACEABILITY_VISION_API_URL=https://llm-api.bs-soft.co.kr
# TRACEABILITY_VISION_MODEL=qwen/qwen3.5-397b-a17b
# TRACEABILITY_VISION_ENDPOINT=/chat/vlm/nim
# TRACEABILITY_VISION_TIMEOUT=120
# TRACEABILITY_VISION_API_KEY=  (미설정 시 LLM_API_KEY Bearer 사용)

# 이메일 파이프라인 (회의록 → 메일 초안 → 발송)
FILE_WATCHER_SETTLE_TIME=5
POLL_INTERVAL=5
PIPELINE_CONFIG=./config/pipelines/email_from_meeting.json

# SMTP (M_Mailer)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@local
SENT_FOLDER=

# --- 인증·결제 서비스 (com.SagoHub.auth-payment) ---
# Supabase Auth (modules/supabase_auth): 회원가입·로그인·OAuth URL
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_ANON_KEY=
# 대시보드 Authentication → Providers에서 Google/Kakao/Naver 활성화 후 Redirect URL 등록

# 결제 허브 (modules/payment_hub)
# PAYMENT_PROVIDER=kpn
# mock: 개발용 | kpn: 한국결제네트웍스(KPN) — 포트원 V2 SDK + api.portone.io (권장)
# portone: 포트원 V1(구 아임포트) — 하위 호환
#
# KPN (포트원 콘솔 [결제연동] > [채널관리]에서 PG=한국결제네트웍스 채널 추가):
# PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PORTONE_API_SECRET=          # V2 API Secret (결제 조회, Authorization: PortOne {secret})
#
# V1(portone) 전용 — kpn 모드에서는 불필요:
# PORTONE_IMP_CODE=
# PORTONE_REST_API_KEY=

# --- QR 도면 관리 UI (services/qr-drawing-manager/frontend 빌드 시) ---
# WebUSB로 TSC 라벨 프린터만 지정할 때(16진, 예: 0x1203). 미설정 시 장치 선택 UI에서 전체 목록 시도
# VITE_WEBUSB_VENDOR_ID=
# VITE_WEBUSB_PRODUCT_ID=
# TSC 라벨(WebUSB·JSPM 공통 TSPL): 용지 가로·세로(mm), 프린터 DPI, 라벨 간격(mm). 용지에 맞게 조정
# VITE_TSPL_LABEL_W_MM=48
# VITE_TSPL_LABEL_H_MM=28
# VITE_TSPL_DPI=203
# VITE_TSPL_GAP_MM=2
# DIRECTION 0/1. 기본 0(가운데 배치 레이아웃). 뒤집힘이면 1 또는 VITE_TSPL_MIRROR=true
# VITE_TSPL_DIRECTION=0
# VITE_TSPL_MIRROR=false
# 프린터 해상도(203/300). 라벨 좌표(dot)에 직접 영향 — 장치와 맞출 것
# VITE_TSPL_DPI=300
# 레거시 고정 mm 좌표(이전 동작). 미설정 시 가운데 정렬·QR 확대 레이아웃 사용
# VITE_TSPL_LEGACY_LAYOUT=false
# 한글 라벨(VITE_TSPL_KOREAN_TEXT=true 시 CODEPAGE 없이도 깨질 수 있음 — TSC 펌웨어에 따라 조정)
# VITE_TSPL_KOREAN_TEXT=false
# QR/텍스트 위치(mm, LEGACY_LAYOUT=true 일 때만)
# VITE_TSPL_QR_X_MM=2
# VITE_TSPL_QR_Y_MM=2.5
# VITE_TSPL_QR_CELL=4
# VITE_TSPL_TEXT_X_MM=17
# VITE_TSPL_TEXT_Y1_MM=3.5
# VITE_TSPL_TEXT_Y2_MM=9
# VITE_TSPL_TEXT_Y3_MM=14.5

# --- Sa-Yu / document-writer (로컬 옵시디언 볼트) ---
# 로컬 FastAPI( services/document-writer/run-local-api.sh ) — OBSIDIAN_VAULT_PATH: 마크다운 루트
# OBSIDIAN_VAULT_PATH=~/obsidian
# SAYU_LOCAL_API_PORT=27100
# (선택) Vite가 프록시할 URL을 고정할 때: SAYU_LOCAL_API_URL=http://127.0.0.1:27100
# SAYU_FILE_WATCH=1
# SAYU_INDEX_DIR=~/.cache/sayu-sagohub
